# JSAN GeoDiscover v5 — copy to backend/.env
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
DEMO_ADMIN_EMAIL=admin@jsanconsulting.com
DEMO_ADMIN_PASSWORD=replace-with-a-new-strong-password
CORS_ORIGINS=http://localhost:8000

# Separate local databases
DATABASE_URL=sqlite:///./customer_demo.db
ENGINE_DATABASE_URL=sqlite:///./discovery_engine.db
EVIDENCE_STORAGE_PATH=./evidence_storage_customer
REDIS_URL=redis://localhost:6379/0

# HERE Geocoding & Search v7 + Maps API for JavaScript
# One key from platform.here.com covers both the /browse POI endpoint and the
# JavaScript basemap. Leave empty to run the HERE leg on mock data and fall back
# to the OpenStreetMap basemap.
HERE_API_KEY=

# Google Places (New) — authorised server key only
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_LANGUAGE_CODE=id
GOOGLE_REGION_CODE=ID

# GrabMaps through Amazon Location Service
AWS_REGION=ap-southeast-1
AWS_LOCATION_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
GRAB_INTENDED_USE=Storage
GRAB_LANGUAGE=id
GRAB_COUNTRY=IDN

# Spend controls
GOOGLE_MAX_CALLS_PER_RUN=2000
GRAB_MAX_CALLS_PER_RUN=2000
GOOGLE_MAX_SPEND_PER_RUN_USD=5.0
GRAB_MAX_SPEND_PER_RUN_USD=5.0

# Official global list rates as of 30 Jul 2026; verify billing profile before use.
RATE_GOOGLE_NEARBY_PER_1K=32.0
RATE_GOOGLE_TEXT_PER_1K=32.0
RATE_GOOGLE_DETAILS_PER_1K=20.0
# AWS Stored rate is account/region dependent. 0.50 is an UNVERIFIED working
# estimate so runs are not reported as unpriced; -1.0 restores "cost unknown".
# Replace with your contracted rate before quoting any cost to a customer.
RATE_GRAB_SEARCH_TEXT_PER_1K=0.50

MATCH_AUTO_THRESHOLD=85
MATCH_POSSIBLE_THRESHOLD=60
MATCH_MAX_DISTANCE_M=300
PROVIDER_PAYLOAD_TTL_DAYS=30
